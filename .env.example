# ── LLM / Embedding ─────────────────────────────────────────
API_KEY=
LLM_MODEL=models/gemini-2.5-flash
LLM_TEMPERATURE=0.2                       # Paper #6: 채점 일관성을 위한 낮은 온도

# ── Server ──────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_HOST_PUBLIC=localhost                  # 대시보드→API 접속용 호스트(브라우저 관점)

# ── Dashboard (Streamlit) ───────────────────────────────────
DASHBOARD_PORT=8501

# CORS (frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
