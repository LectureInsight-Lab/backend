# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default model selection
LLM_PROVIDER=openai            # openai | anthropic
LLM_MODEL=gpt-4o

# Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS (frontend dev)
CORS_ORIGINS=http://localhost:3000

# Cache
LLM_CACHE_ENABLED=true
LLM_CACHE_PATH=.cache/llm
