# ── LLM (Gemini) ────────────────────────────────────────────
API_KEY=
LLM_MODEL=models/gemini-2.5-flash
LLM_TEMPERATURE=0.2

# ── RAG (키워드 검색 — 임베딩 없음) ──────────────────────────
RAG_CHUNK_LINES=15                         # 청크 크기(행)
RAG_TOP_K=5                                # top-K 청크

# ── 앙상블 (Paper #4) ───────────────────────────────────────
ENSEMBLE_LLM_WEIGHT=0.70
ENSEMBLE_BOW_WEIGHT=0.30
CONFIDENCE_THRESHOLD=0.5                    # 미만이면 "인간 검토 권장" 표기

# ── Server ──────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0                           # FastAPI 바인드 주소(모든 인터페이스)
APP_PORT=8000                              # FastAPI 포트
APP_HOST_PUBLIC=localhost                  # 대시보드→API 접속용 호스트(브라우저 관점)

# ── Dashboard (Streamlit) ───────────────────────────────────
DASHBOARD_PORT=8501                        # streamlit run --server.port

# CORS (frontend / streamlit)
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
