# ── LLM / Embedding ─────────────────────────────────────────
API_KEY=
LLM_MODEL=models/gemini-2.5-flash        # production 채점 모델
EVAL_MODEL=models/gemini-2.5-pro         # 골든셋 라벨러/평가 모델 (강한 모델)
LLM_TEMPERATURE=0.2                       # Paper #6: 채점 일관성을 위한 낮은 온도
LLM_CONCURRENCY=3
LLM_DELAY_SEC=0
LLM_THINKING_BUDGET=0

# ── Server ──────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS (Next.js 프론트엔드)
CORS_ORIGINS=http://localhost:3000
