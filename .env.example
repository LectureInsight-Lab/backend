# ── LLM / Embedding ─────────────────────────────────────────
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2                       # Paper #6: 채점 일관성을 위한 낮은 온도
EMBEDDING_MODEL=text-embedding-3-small    # Paper #1, #5: RAG 임베딩

# ── RAG ─────────────────────────────────────────────────────
RAG_CHUNK_LINES=15                        # Paper #1: 15행 단위 청크
RAG_TOP_K=5                               # Paper #2: 컨텍스트 과부하 방지

# ── 앙상블 ──────────────────────────────────────────────────
ENSEMBLE_LLM_WEIGHT=0.70                  # Paper #4: high_inference 항목 가중치
ENSEMBLE_BOW_WEIGHT=0.30
CONFIDENCE_THRESHOLD=0.5                  # Paper #7: 인간 검토 권장 임계값

# ── Server ──────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS (frontend / streamlit)
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ── Cache ───────────────────────────────────────────────────
LLM_CACHE_ENABLED=true
LLM_CACHE_PATH=.cache/llm
EMBEDDING_CACHE_PATH=data/processed/embeddings
